PROVIDER_MODE=mock
NEXT_PUBLIC_API_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TEXT_MODEL=gpt-4.1-mini
# A streamed answer holds its connection open for as long as the model keeps
# writing, so it gets its own, longer deadline than the other provider calls.
OPENAI_STREAM_TIMEOUT_MS=120000

# Local demo only: how the mock answer is cut into deltas, and an optional
# pause between them. Zero keeps the demo instant and the suites fast.
OPENAI_MOCK_STREAM_CHUNK_CHARACTERS=24
OPENAI_STREAM_CHUNK_DELAY_MS=0


# How the spoken conversation sounds.
# A built-in voice name (alloy, ash, ballad, cedar, coral, echo, marin, sage,
# shimmer, verse) or a provisioned custom voice id such as voice_abc123, which
# is how the assistant answers in a specific person's voice. Create one with
# `npm run voice:enroll`; run it with no recordings to be told what to say.
OPENAI_REALTIME_VOICE=marin
# 0.25 to 1.5. Below 1 is easier to follow on a phone speaker.
OPENAI_REALTIME_VOICE_SPEED=1
# semantic_vad waits for a finished thought, server_vad for a silent gap,
# none hands turn-taking to the client.
OPENAI_REALTIME_TURN_DETECTION=semantic_vad
# How readily semantic detection decides the caller has finished:
# low, medium, high or auto.
OPENAI_REALTIME_TURN_EAGERNESS=auto
# near_field for a phone or headset, far_field for a room, off to disable.
OPENAI_REALTIME_NOISE_REDUCTION=near_field
# The model that writes the caller's words into the transcript.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Compose sends YouTube requests to its captions service in both modes.
TRANSCRIPT_MODE=mock

# How much extracted source text is handed to the model per conversation.
# A longer source is windowed from its opening and its ending, never refused.
CONTEXT_CHARACTER_BUDGET=120000

# How long an idle conversation is kept in server memory, in milliseconds.
SESSION_TTL_MS=3600000

# --- Finding a video from spoken words -----------------------------------
# Nobody dictates a URL, so a spoken "YouTube, Miles Davis" is searched rather
# than spelled. "mock" returns deterministic fixtures with no key and no
# network, which is what local runs and the suites use; any other value uses
# the YouTube Data API, and a missing key falls back to the same fixtures with
# a warning rather than breaking the spoken entry path.
YOUTUBE_SEARCH_MODE=mock
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com
# A search sits in a reader's critical path, so it fails fast.
YOUTUBE_SEARCH_TIMEOUT_MS=10000
# How many videos one search returns: the first is opened, the rest are offered.
VIDEO_SEARCH_MAX_RESULTS=5

# YouTube blocks caption requests from cloud address ranges. Set an outbound
# proxy to make the deployed YouTube path work. Leave empty locally.
TRANSCRIPT_PROXY_URL=

# Per-address request budgets, in requests per window.
TEXT_CHAT_RATE_LIMIT=30
TEXT_CHAT_RATE_WINDOW_MS=60000
CONVERSATION_TURNS_RATE_LIMIT=60
CONVERSATION_TURNS_RATE_WINDOW_MS=60000
VIDEO_SEARCH_RATE_LIMIT=20
VIDEO_SEARCH_RATE_WINDOW_MS=60000

# Set to "true" only in tests that deliberately hammer the API.
RATE_LIMIT_DISABLED=

# --- Sign-in gate and spending cap ---------------------------------------
# Every endpoint that spends provider credit sits behind a session and a
# per-account allowance. An unset value — including this one, left commented —
# means "required", so a half-configured deployment fails closed. Compose and
# the test server set AUTH_MODE=disabled themselves, which charges every
# request to one shared local account; leave this alone unless you want the
# real gate locally, which also needs a code read from the server log.
# AUTH_MODE=required

# Name of the session cookie the browser holds.
AUTH_COOKIE_NAME=ursly_session
# How long a confirmed sign-in lasts, in milliseconds. Default: 14 days.
AUTH_SESSION_TTL_MS=1209600000
# Server-side secret mixed into every sign-in code hash. Locally, put a value
# here; without one a per-process value is generated and every code dies with
# the process. A deployment never sets the value: it sets the ARN below, and
# the server reads it from Secrets Manager at startup, exactly as it reads the
# provider key. A deployment with neither refuses sign-in rather than
# improvising a pepper that changes on every restart.
AUTH_HASH_PEPPER=
AUTH_PEPPER_SECRET_ARN=
# The account every request belongs to while AUTH_MODE=disabled.
AUTH_LOCAL_ACCOUNT_EMAIL=local@localhost

# One-time sign-in codes: how many digits, how long they live, and how many
# wrong guesses a challenge survives before it is thrown away.
SIGN_IN_CODE_LENGTH=6
# Bytes of randomness behind a session token.
AUTH_SESSION_TOKEN_BYTES=32
SIGN_IN_CODE_TTL_MS=600000
SIGN_IN_MAX_CODE_ATTEMPTS=5

# The spend cap itself: how many units one account may spend per window.
USAGE_LIMIT_UNITS=300
USAGE_WINDOW_MS=86400000

# What each paid call costs, in units. A voice session bills for as long as it
# lives; an ingestion reads a whole document; a typed question is one question;
# recording a spoken exchange calls no provider at all.
USAGE_UNITS_INGEST=10
USAGE_UNITS_UPLOAD=1
USAGE_UNITS_EXTRACT=10
USAGE_UNITS_TEXT_CHAT=5
USAGE_UNITS_REALTIME=50
USAGE_UNITS_TURNS=1
# A search spends third-party search quota, not model tokens: cheap, not free.
USAGE_UNITS_VIDEO_SEARCH=2

# Per-address budgets for the sign-in endpoints themselves. Requesting a code
# sends mail, so it is the tightest budget in the API.
AUTH_REQUEST_CODE_RATE_LIMIT=5
AUTH_REQUEST_CODE_RATE_WINDOW_MS=900000
AUTH_CONFIRM_RATE_LIMIT=10
AUTH_CONFIRM_RATE_WINDOW_MS=900000
AUTH_SESSION_RATE_LIMIT=60
AUTH_SESSION_RATE_WINDOW_MS=60000

# How the code reaches the reader. Anything other than "ses" writes it to the
# server log as a "local sign-in code" line, so the flow can be completed with
# no mail infrastructure at all.
EMAIL_MODE=log
# Used only when EMAIL_MODE=ses. The sender must be verified in SES, and the
# request is signed with the same AWS credentials the rest of the stack uses.
SES_REGION=
SES_FROM_ADDRESS=
SES_CONFIGURATION_SET=
# What the site tells search engines and answer engines about itself. These are
# read when the pages, the sitemap and /llms.txt are prerendered, so a change
# needs a rebuild. Leave SITE_URL empty to fall back to the production origin.
SITE_URL=
# Comma-separated profiles the same organization is known by.
SITE_SAME_AS=

# The introduction video's YouTube ids, one per narration. Leave empty until
# the videos are published there: the structured data then points at the files
# this origin serves instead.
INTRO_VIDEO_YOUTUBE_ID_EN=
INTRO_VIDEO_YOUTUBE_ID_FR=
# Overrides the date the introduction was first published, as YYYY-MM-DD.
INTRO_VIDEO_PUBLISHED_ON=
