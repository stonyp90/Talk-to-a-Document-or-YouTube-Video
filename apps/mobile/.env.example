# Both simulators use localhost:3000; Android requires adb reverse for 3000/9002.
# Physical devices require a reachable LAN address or HTTPS backend.
# EXPO_PUBLIC_API_URL=http://localhost:3000

# What the paid plan costs, printed exactly as written, e.g. "9 $ / month",
# and where "Get the paid plan" goes. Both are public and inlined into the
# native bundle at build time. Leave them empty until billing opens: the
# pricing step then says the price is announced first, and shows no button.
# EXPO_PUBLIC_PAID_PLAN_PRICE=
# EXPO_PUBLIC_PAID_PLAN_URL=

# Where the live discussion is. A deployment names it, for example
# wss://ws.ursly.io. Left empty, a simulator talking to localhost derives it
# from the API address, and anything else keeps questions on the request path.
# EXPO_PUBLIC_CHAT_SOCKET_URL=
