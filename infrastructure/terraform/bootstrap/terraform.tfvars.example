region             = "us-east-1"
account_id         = "123456789012"
github_repository  = "OWNER/REPO"
openai_secret_arn  = "arn:aws:secretsmanager:us-east-1:123456789012:secret:talk-openai-abcdef"
# Set this if GitHub's account-wide OIDC provider already exists.
# existing_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
# Set all three after applying environments/email, then re-apply bootstrap so
# runtime roles may send as exactly this mailbox. Leave them out to keep the
# account unable to send. The GitHub SES_FROM_ADDRESS variable must match.
# ses_identity_arn           = "arn:aws:ses:us-east-1:123456789012:identity/example.com"
# ses_configuration_set_name = "talk-to-a-document-transactional"
# ses_from_address           = "no-reply@example.com"
