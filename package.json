{
  "name": "talk-to-a-document",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @talk/web --",
    "build": "npm run build --workspace @talk/web",
    "start": "npm run start --workspace @talk/web --",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gherkin": "cucumber-js --format progress",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "security:secrets": "node scripts/security/scan.mjs",
    "demo:check": "node scripts/demo/check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-secrets-manager": "^3.1127.0",
    "@aws-sdk/s3-presigned-post": "^3.1127.0",
    "@napi-rs/canvas": "^0.1.80",
    "next": "^16.3.4",
    "openai": "5.10.2",
    "pdf-parse": "^2.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  }
}
