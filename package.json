{
  "name": "talk-to-a-document",
  "version": "0.1.1",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @talk/web",
    "start": "npm run start --workspace @talk/web --",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gherkin": "cucumber-js --format progress",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "voice:enroll": "tsx scripts/voice/enroll.ts",
    "security:secrets": "node scripts/security/scan.mjs",
    "demo:check": "node scripts/demo/check.mjs",
    "dev:web": "npm run dev --workspace @talk/web --",
    "dev:chat": "tsx services/chat/src/main.ts",
    "build:chat": "node scripts/chat/build.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-secrets-manager": "^3.1127.0",
    "@aws-sdk/s3-presigned-post": "^3.1127.0",
    "@napi-rs/canvas": "^1.0.8",
    "next": "^16.3.4",
    "openai": "7.10.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "5.8.3",
    "vitest": "^5.0.0"
  }
}
